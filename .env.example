# ── 서버 환경변수 (server가 읽음) ──
PORT=8787
# 개발 시 Vite dev 서버 주소 (CORS 허용). 프로덕션은 동일 출처라 비워도 됨.
CLIENT_ORIGIN=http://localhost:5173

# ── Supabase ──
SUPABASE_URL=https://supabase-axedu.kodekorea.kr
# ⚠️ service_role 키 (비밀!). Supabase 대시보드 > Project Settings > API > service_role 에서 복사.
# 이 키만 RLS를 우회해 axedu_* 테이블에 접근할 수 있습니다. 절대 클라이언트에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_키_붙여넣기

# ── MiniMax (텍스트/대화, 비교 랩) ──
# https://www.minimax.io  (또는 https://api.minimaxi.chat)
MINIMAX_API_KEY=여기에_minimax_키
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

# ── Stability (이미지 생성) ──
# https://platform.stability.ai
STABILITY_API_KEY=여기에_stability_키
STABILITY_BASE_URL=https://api.stability.ai

# ── 안전/쿼터 기본값 (강의실 생성 시 덮어쓸 수 있음) ──
QUOTA_CHAT_PER_ACTIVITY=8
QUOTA_IMAGE_PER_ACTIVITY=4
CLASSROOM_BUDGET_USD=15

# ── 인증 (구글 원클릭 로그인) ──
# JWT 서명용 비밀키 (충분히 긴 랜덤 문자열)
AUTH_JWT_SECRET=여기에_긴_랜덤_문자열
# OAuth 콜백 기준 주소 (개발: 클라 dev 서버 주소)
APP_ORIGIN=http://localhost:5173
# 1이면 /api/auth/dev-login 활성화 (로컬 개발 전용 — 프로덕션 금지)
DEV_LOGIN=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 관리자 ──
# 콤마 구분 이메일 목록 — 해당 계정 로그인 시 자동 super_admin 승격
ADMIN_EMAILS=

# ── 결제 (토스페이먼츠) ──
# mock: 실키 없이 승인 플로우 시뮬레이션 / toss: 아래 키 사용
BILLING_PROVIDER=mock
# 개발자센터(https://developers.tosspayments.com/my/api-keys)에서 발급.
# 클라이언트 키(test_ck_/live_ck_)는 브라우저 노출용, 시크릿 키(test_sk_/live_sk_)는 서버 전용 — 절대 클라 노출 금지.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
